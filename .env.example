# Kafka
KAFKA_CLUSTER_ID=MkU3OEVBNTcwNTJENDM2Qk
MIN_ISR=2
MAX_CONSUMIDORES=3
KAFKA_IMAGEM=apache/kafka:3.8.0
KAFKA_BOOTSTRAP=kafka-1-0.kafka-headless:9092,kafka-2-0.kafka-headless:9092,kafka-3-0.kafka-headless:9092
TOPICO_SENSORES=dados-sensores
PARTICOES=3
REPLICACAO=3
GRUPO_CONSUMIDORES=processadores

# Consumidores (tempos do protocolo de grupo; definem a velocidade do failover)
SESSION_TIMEOUT_MS=10000
HEARTBEAT_INTERVAL_MS=3000
MAX_POLL_INTERVAL_MS=300000
AUTO_COMMIT_INTERVAL_MS=5000

# Sensores
INTERVALO_SEGUNDOS=2
TEMP_LIMITE=50.0
VIBRACAO_LIMITE=10.0
UMIDADE_LIMITE=80.0
ENERGIA_LIMITE=200.0

# Persistência dos dados processados (DIR_DADOS = mountPath em k8s/consumidor.yaml)
PERSISTENCIA_ATIVA=true
DIR_DADOS=/dados
ARQUIVO_DADOS=dados-processados.jsonl
ARQUIVO_ALERTAS=alertas.jsonl

# Faixas de simulação dos sensores
TEMP_MIN=15.0
TEMP_MAX=55.0
VIBRACAO_MIN=0.0
VIBRACAO_MAX=12.0
UMIDADE_MIN=35.0
UMIDADE_MAX=90.0
ENERGIA_MIN=50.0
ENERGIA_MAX=220.0

# ---------- Ferramentas do host (Makefile e scripts) ----------
# Timeout das CLIs do Kafka. O padrão da kafka-consumer-groups.sh é 5s, curto
# demais aqui: a CLI sobe uma JVM dentro do próprio broker, que está limitado
# a 500m de CPU, e o describe estourava antes de encontrar o coordenador.
TIMEOUT_CLI_MS=30000

# Ajustes do Docker Hub
DOCKER_USER=seu-usuario
TAG_SENSOR=v1
TAG_CONSUMIDOR=v1
