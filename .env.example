# Kafka
KAFKA_CLUSTER_ID=MkU3OEVBNTcwNTJENDM2Qk
KAFKA_BOOTSTRAP=kafka1:19092,kafka2:19092,kafka3:19092
TOPICO_SENSORES=dados-sensores
PARTICOES=3
REPLICACAO=3
GRUPO_CONSUMIDORES=processadores

# Consumidores (tempos do protocolo de grupo; definem a velocidade do failover)
SESSION_TIMEOUT_MS=6000
HEARTBEAT_INTERVAL_MS=2000
MAX_POLL_INTERVAL_MS=300000
AUTO_COMMIT_INTERVAL_MS=5000

# Sensores
INTERVALO_SEGUNDOS=2
TEMP_LIMITE=50.0
VIBRACAO_LIMITE=10.0
UMIDADE_LIMITE=80.0
ENERGIA_LIMITE=200.0

# Faixas de simulação dos sensores
TEMP_MIN=15.0
TEMP_MAX=55.0
VIBRACAO_MIN=0.0
VIBRACAO_MAX=12.0
UMIDADE_MIN=35.0
UMIDADE_MAX=90.0
ENERGIA_MIN=50.0
ENERGIA_MAX=220.0

# Ajustes do Docker Hub
DOCKER_USER=seu-usuario
TAG_SENSOR=v1
TAG_CONSUMIDOR=v1
